#!/usr/bin/env python3
"""Fake `bun` for the frontend pre-step tests. No network. Not on PATH by default (QaEnv.with_bun()).

FAKE_TOOL_LOG=<path>   each call appends {"tool", "argv", "cwd", "files"} as one JSON line
FAKE_BUN_FAIL=1        each call prints an error on stderr and exits 1
"""
import json
import os
import sys

if os.environ.get("FAKE_TOOL_LOG"):
    with open(os.environ["FAKE_TOOL_LOG"], "a", encoding="utf-8") as f:
        f.write(json.dumps({"tool": "bun", "argv": sys.argv[1:], "cwd": os.getcwd(),
                            "files": sorted(os.listdir("."))}) + "\n")
if os.environ.get("FAKE_BUN_FAIL") == "1":
    sys.stderr.write("bun install v1.2.0 (synthetic)\n\n"
                     "error: lockfile had changes, but lockfile is frozen\nsecond line\n")
    sys.exit(1)
sys.exit(0)
