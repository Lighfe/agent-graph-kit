#!/usr/bin/env python3
"""Fake `docker` for the monitor smoke-check tests (#319). No daemon, no network. Controlled by:

FAKE_DOCKER_LOG=<path>       each call appends {"argv", "project"} as one JSON line; "project" is the
                             value of COMPOSE_PROJECT_NAME in the environment of the call
FAKE_DOCKER_INFO_FAIL=1      `docker info` exits 1
FAKE_DOCKER_PS=<text>        `docker ps` prints this text (the containers that are left)
FAKE_DOCKER_VOLUMES=<text>   `docker volume ls` prints this text
FAKE_DOCKER_DOWN_FAIL=1      `docker compose ... down` prints an error and exits 1
"""
import json
import os
import sys

argv = sys.argv[1:]
if os.environ.get("FAKE_DOCKER_LOG"):
    with open(os.environ["FAKE_DOCKER_LOG"], "a", encoding="utf-8") as f:
        f.write(json.dumps({"argv": argv, "project": os.environ.get("COMPOSE_PROJECT_NAME")}) + "\n")
if argv[:1] == ["info"] and os.environ.get("FAKE_DOCKER_INFO_FAIL") == "1":
    sys.stderr.write("Cannot connect to the Docker daemon\n")
    sys.exit(1)
if argv[:1] == ["compose"] and "down" in argv and os.environ.get("FAKE_DOCKER_DOWN_FAIL") == "1":
    sys.stderr.write("error: cannot stop\n")
    sys.exit(1)
if argv[:1] == ["ps"]:
    print(os.environ.get("FAKE_DOCKER_PS", ""))
if argv[:2] == ["volume", "ls"]:
    print(os.environ.get("FAKE_DOCKER_VOLUMES", ""))
