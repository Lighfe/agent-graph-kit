#!/usr/bin/env python3
"""Fake `npm` for the qa-codex tests. No network.

FAKE_TOOL_LOG=<path>   each call appends {"tool", "argv", "cwd", "files"} as one JSON line
FAKE_NPM_FAIL=1        each call prints an error on stderr and exits 1
"""
import json
import os
import sys

tool = os.path.basename(sys.argv[0])
if os.environ.get("FAKE_TOOL_LOG"):
    with open(os.environ["FAKE_TOOL_LOG"], "a", encoding="utf-8") as f:
        f.write(json.dumps({"tool": tool, "argv": sys.argv[1:], "cwd": os.getcwd(),
                            "files": sorted(os.listdir("."))}) + "\n")
if os.environ.get("FAKE_NPM_FAIL") == "1":
    sys.stderr.write(f"\n{tool} ERR! synthetic failure\n{tool} ERR! second line\n")
    sys.exit(1)
sys.exit(0)
