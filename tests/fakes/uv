#!/usr/bin/env python3
"""Fake `uv` for the qa-codex tests. No network. Not on PATH by default (QaEnv.with_uv()).

FAKE_TOOL_LOG=<path>   each call appends {"tool", "argv", "cwd", "files", "cache"} as one JSON line,
                       "cache" is the value of UV_CACHE_DIR
Each call creates UV_CACHE_DIR with a file in it, as the real `uv` fills its cache.
FAKE_UV_FAIL=1         each call prints an error on stderr and exits 2
FAKE_UV_WAIT=<path>    each call starts a child `sleep 30`, writes its PID to <path> and waits for it
"""
import json
import os
import subprocess
import sys

cache = os.environ.get("UV_CACHE_DIR", "")
if os.environ.get("FAKE_TOOL_LOG"):
    with open(os.environ["FAKE_TOOL_LOG"], "a", encoding="utf-8") as f:
        f.write(json.dumps({"tool": "uv", "argv": sys.argv[1:], "cwd": os.getcwd(),
                            "files": sorted(os.listdir(".")), "cache": cache}) + "\n")
if cache:
    os.makedirs(os.path.join(cache, "wheels-v6"), exist_ok=True)
    with open(os.path.join(cache, "wheels-v6", "pytest.whl"), "w", encoding="utf-8") as f:
        f.write("synthetic\n")
if os.environ.get("FAKE_UV_FAIL") == "1":
    sys.stderr.write("\nerror: Failed to fetch: `https://pypi.org/simple/pytest/`\n  Caused by: second line\n")
    sys.exit(2)
if os.environ.get("FAKE_UV_WAIT"):
    child = subprocess.Popen(["sleep", "30"])
    with open(os.environ["FAKE_UV_WAIT"], "w", encoding="utf-8") as f:
        f.write(str(child.pid))
    child.wait()
sys.exit(0)
