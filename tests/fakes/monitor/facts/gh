#!/usr/bin/env python3
"""Fake `gh` for tests/test_monitor_facts.py. It answers the three read calls of facts.py from the JSON
file $FAKE_GH_FIXTURE and logs each argument list to $FAKE_GH_LOG. When the file $FAKE_GH_FAIL exists
it fails. All data is synthetic."""
import json
import os
import sys

args = sys.argv[1:]
with open(os.environ["FAKE_GH_LOG"], "a") as f:
    f.write(json.dumps({"args": args, "cwd": os.getcwd()}) + "\n")
if os.path.exists(os.environ.get("FAKE_GH_FAIL", "/nonexistent")):
    sys.stderr.write("fake gh: no network in tests\n")
    sys.exit(1)
fx = json.load(open(os.environ["FAKE_GH_FIXTURE"]))
if args[:2] == ["issue", "list"]:
    print(json.dumps(fx["stages"]))
elif args[:2] == ["issue", "view"]:
    print(json.dumps({"comments": fx["comments"].get(args[2], [])}))
elif args[:1] == ["api"]:
    stage = args[2].split("/")[-2]
    for sub in fx["subs"].get(stage, []):
        print(json.dumps(sub))
else:
    sys.stderr.write("fake gh: unknown call\n")
    sys.exit(2)
