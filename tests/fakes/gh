#!/usr/bin/env python3
"""Fake `gh` for the guard tests. No network. Controlled by the environment:

FAKE_GH_ISSUE=<path>     JSON that `gh issue view` prints; `gh issue comment` appends to its comments
FAKE_GH_LOG=<path>       `gh issue comment` appends {"issue": n, "body": ...} as one JSON line
FAKE_GH_CALLS=<path>     every call appends its argv as one JSON line
FAKE_GH_FAIL=1           every call exits 1
FAKE_GH_COMMENT_FAIL=1   only `gh issue comment` exits 1
FAKE_GH_VIEW_FAIL=1      only `gh issue view` exits 1
FAKE_GH_STATES=<json>    map of issue number to state, e.g. {"3": "CLOSED"}: `gh issue view N --json state`
                         prints {"state": <value>}; a number not in the map exits 1
FAKE_GH_SLEEP=<s>        sleep before answering
FAKE_GH_STDERR=<text>    stderr of a failing call
FAKE_GH_API=<path>       JSON object for `gh api <path> --paginate`, keyed by the read: "timeline",
                         "blocked_by", "sub_issues", "issues" (the repo's issue list). A list value is
                         printed as JSON; a string value is printed as it is (raw output, e.g. two
                         pages or text that is not JSON). A missing file or key prints `[]`.
                         The two blocker reads with --jq (issue #64) use the keys "blocked_by" (a
                         list of pages) and "issue" (the issue object); see the comment at that branch
FAKE_GH_API_FAIL=<key>   only the `gh api` read with that key exits 1
"""
import json
import os
import re
import sys
import time

env = os.environ.get
args = sys.argv[1:]


def append(path, record):
    with open(path, "a", encoding="utf-8") as f:
        f.write(json.dumps(record) + "\n")


def fail():
    sys.stderr.write(env("FAKE_GH_STDERR", "gh: synthetic failure\n"))
    sys.exit(1)


if env("FAKE_GH_CALLS"):
    append(env("FAKE_GH_CALLS"), args)
if env("FAKE_GH_SLEEP"):
    time.sleep(float(env("FAKE_GH_SLEEP")))
if env("FAKE_GH_FAIL") == "1":
    fail()

if args[:2] == ["issue", "view"]:
    if env("FAKE_GH_VIEW_FAIL") == "1":
        fail()
    if args[3:] == ["--json", "state"]:
        states = json.loads(env("FAKE_GH_STATES", "{}"))
        if args[2] not in states:
            fail()
        sys.stdout.write(json.dumps({"state": states[args[2]]}))
        sys.exit(0)
    with open(env("FAKE_GH_ISSUE"), encoding="utf-8") as f:
        sys.stdout.write(f.read())
    sys.exit(0)

if args[:2] == ["issue", "comment"] and args[3:] == ["--body-file", "-"]:
    if env("FAKE_GH_COMMENT_FAIL") == "1":
        fail()
    body = sys.stdin.read()
    if env("FAKE_GH_LOG"):
        append(env("FAKE_GH_LOG"), {"issue": int(args[2]), "body": body})
    if env("FAKE_GH_ISSUE"):
        with open(env("FAKE_GH_ISSUE"), encoding="utf-8") as f:
            text = f.read()
        try:
            data = json.loads(text)
            data["comments"].append({"body": body, "authorAssociation": "OWNER"})
        except (ValueError, KeyError, TypeError, AttributeError):
            data = None  # a test issue that `gh issue view` must fail to parse: keep it as it is
        if data is not None:
            with open(env("FAKE_GH_ISSUE"), "w", encoding="utf-8") as f:
                json.dump(data, f)
    sys.exit(0)



def api_key(path):
    """The read that a `gh api` path names, or None."""
    if path.endswith("/timeline"):
        return "timeline"
    if path.endswith("/dependencies/blocked_by"):
        return "blocked_by"
    if path.endswith("/sub_issues"):
        return "sub_issues"
    if path.split("?", 1)[0].endswith("/issues"):
        return "issues"
    return None


BLOCKERS_JQ = ".[] | {repo: .repository.full_name, number, state}"
COUNT_JQ = ".issue_dependencies_summary.blocked_by"
DEFAULT_ISSUE = {"issue_dependencies_summary": {"blocked_by": 0}}


def api_data():
    if env("FAKE_GH_API") and os.path.exists(env("FAKE_GH_API")):
        with open(env("FAKE_GH_API"), encoding="utf-8") as f:
            return json.load(f)
    return {}


def dig(value, *keys):
    for key in keys:
        value = value.get(key) if isinstance(value, dict) else None
    return value


# The blocker reads of the guard (issue #64), with the two --jq expressions emulated:
#   gh api --paginate repos/{owner}/{repo}/issues/<n>/dependencies/blocked_by --jq BLOCKERS_JQ
#     FAKE_GH_API key "blocked_by": a list of pages (lists of REST items); with --paginate every page,
#     without it only the first page; a string is printed as it is
#   gh api repos/{owner}/{repo}/issues/<n> --jq COUNT_JQ
#     FAKE_GH_API key "issue": the REST issue object (default: count 0); a string is printed as it is
if args[:1] == ["api"] and "--jq" in args:
    jq = args[args.index("--jq") + 1] if args.index("--jq") + 1 < len(args) else None
    rest = [a for i, a in enumerate(args[1:], 1) if a not in ("--paginate", "--jq") and args[i - 1] != "--jq"]
    path = rest[0] if len(rest) == 1 else ""
    key = "issue" if re.fullmatch(r"repos/[^/]+/[^/]+/issues/[0-9]+", path) else api_key(path)
    if (key, jq) not in (("blocked_by", BLOCKERS_JQ), ("issue", COUNT_JQ)):
        sys.stderr.write(f"fake gh: unsupported call {args}\n")
        sys.exit(2)
    if env("FAKE_GH_API_FAIL") == key:
        fail()
    data = api_data()
    if key == "issue":
        value = data.get("issue", DEFAULT_ISSUE)
        sys.stdout.write(value if isinstance(value, str) else json.dumps(dig(value, *COUNT_JQ[1:].split("."))) + "\n")
        sys.exit(0)
    value = data.get("blocked_by", [[]])
    if isinstance(value, str):
        sys.stdout.write(value)
        sys.exit(0)
    pages = value if "--paginate" in args else value[:1]
    for page in pages:
        for item in page:
            out = {"number": item.get("number"), "repo": dig(item, "repository", "full_name"),
                   "state": item.get("state")}
            sys.stdout.write(json.dumps(out, separators=(",", ":"), sort_keys=True) + "\n")
    sys.exit(0)


if args[:1] == ["api"] and len(args) == 3 and args[2] == "--paginate" and api_key(args[1]):
    key = api_key(args[1])
    if env("FAKE_GH_API_FAIL") == key:
        fail()
    data = {}
    if env("FAKE_GH_API") and os.path.exists(env("FAKE_GH_API")):
        with open(env("FAKE_GH_API"), encoding="utf-8") as f:
            data = json.load(f)
    value = data.get(key, [])
    sys.stdout.write(value if isinstance(value, str) else json.dumps(value))
    sys.exit(0)

sys.stderr.write(f"fake gh: unsupported call {args}\n")
sys.exit(2)
