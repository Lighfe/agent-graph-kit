#!/usr/bin/env python3
"""Fake `gh` for the guard tests. No network. Controlled by the environment:

FAKE_GH_ISSUE=<path>     JSON that `gh issue view` prints; `gh issue comment` appends to its comments
FAKE_GH_LOG=<path>       `gh issue comment` appends {"issue": n, "body": ...} as one JSON line
FAKE_GH_CALLS=<path>     every call appends its argv as one JSON line
FAKE_GH_FAIL=1           every call exits 1
FAKE_GH_COMMENT_FAIL=1   only `gh issue comment` exits 1
FAKE_GH_SLEEP=<s>        sleep before answering
FAKE_GH_STDERR=<text>    stderr of a failing call
"""
import json
import os
import sys
import time

env = os.environ.get
args = sys.argv[1:]


def append(path, record):
    with open(path, "a", encoding="utf-8") as f:
        f.write(json.dumps(record) + "\n")


def fail():
    sys.stderr.write(env("FAKE_GH_STDERR", "gh: synthetic failure\n"))
    sys.exit(1)


if env("FAKE_GH_CALLS"):
    append(env("FAKE_GH_CALLS"), args)
if env("FAKE_GH_SLEEP"):
    time.sleep(float(env("FAKE_GH_SLEEP")))
if env("FAKE_GH_FAIL") == "1":
    fail()

if args[:2] == ["issue", "view"]:
    with open(env("FAKE_GH_ISSUE"), encoding="utf-8") as f:
        sys.stdout.write(f.read())
    sys.exit(0)

if args[:2] == ["issue", "comment"] and args[3:] == ["--body-file", "-"]:
    if env("FAKE_GH_COMMENT_FAIL") == "1":
        fail()
    body = sys.stdin.read()
    if env("FAKE_GH_LOG"):
        append(env("FAKE_GH_LOG"), {"issue": int(args[2]), "body": body})
    if env("FAKE_GH_ISSUE"):
        with open(env("FAKE_GH_ISSUE"), encoding="utf-8") as f:
            data = json.load(f)
        data["comments"].append({"body": body})
        with open(env("FAKE_GH_ISSUE"), "w", encoding="utf-8") as f:
            json.dump(data, f)
    sys.exit(0)

sys.stderr.write(f"fake gh: unsupported call {args}\n")
sys.exit(2)
