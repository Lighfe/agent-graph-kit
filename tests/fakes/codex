#!/usr/bin/env python3
"""Fake `codex` for the qa-codex tests. No network. Controlled by the environment:

FAKE_CODEX_MODES=<path>   one mode per line; each call pops the first line (default mode: ok)
FAKE_CODEX_N=<n>          number of criteria in the JSON (default 2)
FAKE_CODEX_PID=<path>     mode timeout writes the PID of its child here
FAKE_TOOL_LOG=<path>      each call appends {"tool", "argv", "cwd", "stdin", "tree"} as one JSON line;
                          "tree" maps each file below the working directory (no `.git`) to its text

Modes:
  ok           valid JSON in the -o file: every id 1..N passes, verified_sha = git rev-parse HEAD
  invalid      like ok, criterion 1 has verdict invalid
  fail         like ok, criterion 2 fails, the top-level verdict stays pass
  missing      leaves out the last id
  duplicate    repeats id 1 in place of the last id
  short_sha    verified_sha is a 7-character SHA
  empty        exits 0 and leaves the -o file empty
  extra        like ok, with an extra property in one criterion entry
  write        like ok, but first writes a file into the working directory
  transient    turn.failed with the 500 text of the S2 error table, exit 1
  unavailable  turn.failed with the usage limit text, exit 1
  nologin      turn.failed with the 401 text, exit 1
  unknown      turn.failed with an invalid-schema error, exit 1
  timeout      starts a child `sleep 30`, writes its PID, waits for it
  dirty        changes frontend/package.json, adds frontend/untracked.txt, root-untracked.txt and
               frontend/node_modules/keep.txt, then fails like transient
  crash        prints the banner and the prompt on stderr, then kills itself with SIGSEGV
  panic        prints a Rust panic on stderr after the banner and the prompt, exit 101
The error modes print a banner and the prompt on stderr, as the real CLI does.
"""
import json
import os
import signal
import subprocess
import sys

env = os.environ.get
args = sys.argv[1:]
prompt = sys.stdin.read()



def tree():
    files = {}
    for folder, dirs, names in os.walk("."):
        dirs[:] = sorted(d for d in dirs if d != ".git")
        for name in sorted(names):
            if name == ".git":
                continue
            path = os.path.relpath(os.path.join(folder, name))
            with open(path, encoding="utf-8", errors="replace") as f:
                files[path] = f.read()
    return files


if env("FAKE_TOOL_LOG"):
    with open(env("FAKE_TOOL_LOG"), "a", encoding="utf-8") as f:
        f.write(json.dumps({"tool": "codex", "argv": args, "cwd": os.getcwd(), "stdin": prompt,
                            "tree": tree()}) + "\n")

mode = "ok"
if env("FAKE_CODEX_MODES"):
    with open(env("FAKE_CODEX_MODES"), encoding="utf-8") as f:
        lines = f.read().splitlines()
    if lines:
        mode = lines[0].strip()
        with open(env("FAKE_CODEX_MODES"), "w", encoding="utf-8") as f:
            f.write("".join(line + "\n" for line in lines[1:]))

out = args[args.index("-o") + 1]
n = int(env("FAKE_CODEX_N", "2"))

ERRORS = {
    "transient": "We're currently experiencing high demand, which may cause temporary errors.",
    "unavailable": "You've hit your usage limit. Try again at Sep 27th, 2026 11:06 AM.",
    "nologin": ("unexpected status 401 Unauthorized: Missing bearer or basic authentication in header, "
                "url: https://api.openai.com/v1/responses, cf-ray: <redacted>, request id: <redacted>"),
    "unknown": ('{\n  "type": "error",\n  "error": {\n    "type": "invalid_request_error",\n'
                '    "code": "invalid_json_schema"\n  }\n}'),
}

if mode == "dirty":
    for path, text in (("frontend/package.json", '{"name": "changed by the fake codex"}\n'),
                       ("frontend/untracked.txt", "untracked\n"), ("root-untracked.txt", "untracked\n"),
                       ("frontend/node_modules/keep.txt", "installed\n")):
        os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            f.write(text)
    mode = "transient"

if mode in ERRORS:
    msg = ERRORS[mode]
    sys.stderr.write("OpenAI Codex v0.153.4 (fake)\n--------\nworkdir: " + os.getcwd() + "\n--------\nuser\n"
                     + prompt + "\n2026-09-26T13:12:14.490070Z ERROR codex_api: synthetic log line\n")
    for event in ({"type": "thread.started", "thread_id": "<thread-id>"}, {"type": "turn.started"},
                  {"type": "error", "message": msg}, {"type": "turn.failed", "error": {"message": msg}}):
        print(json.dumps(event))
    sys.exit(1)

BANNER = ("OpenAI Codex v0.153.4 (fake)\n--------\nworkdir: " + os.getcwd() + "\n--------\nuser\n"
          + prompt + "\n")

if mode == "crash":
    sys.stderr.write(BANNER)
    sys.stderr.flush()
    try:  # no core dump: an apport or systemd-coredump handler takes about 1 s (Linux PR_SET_DUMPABLE)
        import ctypes
        ctypes.CDLL(None).prctl(4, 0, 0, 0, 0)
    except (OSError, AttributeError):
        pass
    os.kill(os.getpid(), signal.SIGSEGV)

if mode == "panic":
    sys.stderr.write(BANNER + "\nthread 'main' panicked at codex-rs/core/src/synthetic.rs:12:5:\n"
                     "synthetic panic\nnote: run with `RUST_BACKTRACE=1` environment variable to display a backtrace\n")
    sys.exit(101)

if mode == "timeout":
    child = subprocess.Popen(["sleep", "30"])
    with open(env("FAKE_CODEX_PID"), "w", encoding="utf-8") as f:
        f.write(str(child.pid))
    child.wait()
    sys.exit(0)

print(json.dumps({"type": "thread.started", "thread_id": "<thread-id>"}))
if mode == "empty":
    open(out, "w").close()
    sys.exit(0)
if mode == "write":
    with open("qa-scratch.txt", "w", encoding="utf-8") as f:
        f.write("written by the fake codex\n")

head = subprocess.run(["git", "rev-parse", "HEAD"], capture_output=True, text=True, check=True).stdout.strip()
criteria = [{"id": i, "verdict": "pass", "evidence": f"synthetic evidence {i}"} for i in range(1, n + 1)]
result = {"verdict": "pass", "criteria": criteria,
          "tests": {"command": "uv run --with pytest pytest", "result": "3 passed, 0 failed"},
          "verified_sha": head}
if mode == "invalid":
    criteria[0].update(verdict="invalid", evidence="the browser crashed")
elif mode == "fail":
    criteria[1].update(verdict="fail", evidence="second signup printed a traceback")
elif mode == "missing":
    criteria.pop()
elif mode == "duplicate":
    criteria[-1] = dict(criteria[0])
elif mode == "short_sha":
    result["verified_sha"] = head[:7]
elif mode == "extra":
    criteria[0]["note"] = "extra"
elif mode not in ("ok", "write"):
    sys.stderr.write(f"fake codex: unknown mode {mode}\n")
    sys.exit(2)
with open(out, "w", encoding="utf-8") as f:
    json.dump(result, f)
print(json.dumps({"type": "turn.completed"}))
sys.exit(0)
