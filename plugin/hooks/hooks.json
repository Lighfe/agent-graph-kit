{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Bash|SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\" || { echo 'guard hook failed: call denied' >&2; exit 2; }",
            "timeout": 120
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script \"${CLAUDE_PLUGIN_ROOT}/hooks/outage_stop.py\" || true",
            "timeout": 120
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": "Agent|Bash|SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script \"${CLAUDE_PLUGIN_ROOT}/hooks/not_started.py\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
